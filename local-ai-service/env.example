# Ключи и адреса сервиса. Скопировать в .env и подставить свои значения:
#   Copy-Item .env.example .env
#
# .env в репозиторий не попадает (см. .gitignore): ключ — это то, что отделяет
# приватный сервис от открытого порта.

# Ключ администратора сервиса: им ходят и клиенты (в этой схеме он один).
LITELLM_MASTER_KEY=sk-local-change-me

# Ключ для самого Ollama. Он фиктивный: Ollama на 127.0.0.1 не проверяет ключи,
# но клиент без ключа не соберётся.
OLLAMA_API_KEY=ollama

# Где слушает сервис. 0.0.0.0 — доступен по сети (LAN/VPN), 127.0.0.1 — только
# с этой машины. Для дня 30 нужен первый вариант, иначе «доступ по сети» не проверить.
LITELLM_HOST=0.0.0.0
LITELLM_PORT=4000

# Адрес сервиса, каким его видят клиенты: для проверок и скриптов.
SERVICE_URL=http://127.0.0.1:4000

# Порт веб-чата (Open WebUI).
WEBUI_PORT=3000

# Необязательно: адрес этой машины в локальной сети, чтобы проверять доступ
# не только с localhost. Узнать: (Get-NetIPAddress -AddressFamily IPv4).IPAddress
LAN_IP=10.0.1.220
